<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SwellSSH.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Swell SSH">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <!-- Theme transition overlay (circular wipe animation) -->
        <Grid x:Name="ThemeTransitionOverlay" Visibility="Collapsed"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border x:Name="ThemeTransitionBackground" />
            <Image x:Name="ThemeTransitionImage" Stretch="None"
                   HorizontalAlignment="Left" VerticalAlignment="Top" />
        </Grid>

        <!-- Main content wrapper — clip animation targets this -->
        <Grid x:Name="ContentWrapper">
            <NavigationView x:Name="MainNav"
                            PaneDisplayMode="LeftMinimal"
                            IsPaneOpen="False"
                            OpenPaneLength="240"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            AlwaysShowHeader="False"
                            Header=""
                            Background="Transparent">

                <NavigationView.PaneHeader>
                    <Grid Height="32" />
                </NavigationView.PaneHeader>

                <NavigationView.Resources>
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBackground" Color="Transparent" />
                </NavigationView.Resources>

                <NavigationView.MenuItems>
                    <!-- SSH Connections -->
                    <NavigationViewItem x:Name="ConnectionsNavItem"
                                        Content="SSH 连接"
                                        Tag="connections"
                                        ToolTipService.ToolTip="SSH 连接管理"
                                        PointerEntered="ConnectionsNavItem_PointerEntered"
                                        PointerExited="ConnectionsNavItem_PointerExited">
                        <NavigationViewItem.Icon>
                            <FontIcon x:Name="ConnectionsNavIcon" Glyph="&#xE8C8;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItemSeparator/>

                    <!-- Settings -->
                    <NavigationViewItem x:Name="SettingsNavItem"
                                        Content="设置"
                                        Tag="settings"
                                        ToolTipService.ToolTip="应用设置"
                                        PointerEntered="SettingsNavItem_PointerEntered"
                                        PointerExited="SettingsNavItem_PointerExited">
                        <NavigationViewItem.Icon>
                            <FontIcon x:Name="SettingsNavIcon" Glyph="&#xE713;" />
                        </NavigationViewItem.Icon>
                        <NavigationViewItem.InfoBadge>
                            <InfoBadge x:Name="UpdateBadge" Style="{ThemeResource AttentionIconInfoBadgeStyle}" Visibility="Collapsed" />
                        </NavigationViewItem.InfoBadge>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <Frame x:Name="ContentFrame" Margin="0,48,0,0" />
            </NavigationView>

            <!-- Global Sidebar Toggle Button: aligned to the left after hamburger menu -->
            <Button x:Name="GlobalToggleSidebarButton"
                    VerticalAlignment="Top" HorizontalAlignment="Left"
                    Width="36" Height="36"
                    Margin="48,6,0,0"
                    CornerRadius="4"
                    Background="Transparent" BorderBrush="Transparent"
                    Padding="0"
                    Click="GlobalToggleSidebarButton_Click" ToolTipService.ToolTip="切换终端工具箱">
                <FontIcon Glyph="&#xE90D;" FontSize="14"/>
            </Button>

            <!-- Logo area (shown when pane is closed) -->
            <StackPanel x:Name="LogoStackPanel"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Margin="92,0,0,0"
                        Height="48" Spacing="8"
                        HorizontalAlignment="Left"
                        IsHitTestVisible="False">
                <Image x:Name="TitleBarLogo"
                       Source="ms-appx:///Assets/tray-icon.ico"
                       Width="18" Height="18"
                       VerticalAlignment="Center" Stretch="Uniform"/>
                <TextBlock Text="Swell SSH"
                           FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Drag region for custom title bar -->
            <Grid x:Name="AppTitleBar" Height="48" Background="Transparent"
                  VerticalAlignment="Top" Margin="240,0,140,0"/>

        </Grid>
        <!-- 新手引导遮罩层：懒加载，首次需要时才由代码注入 OnboardingControl 实例 -->
        <ContentControl x:Name="AppOnboardingHost" Visibility="Collapsed" Canvas.ZIndex="100"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
