<Page
    x:Class="SwellSSH.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SwellSSH.Pages"
    xmlns:models="using:SwellSSH.Models"
    xmlns:ui="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="SidebarGroupTemplate" x:DataType="local:ConnectionGroupViewModel">
            <Grid Padding="0,12,0,4" Background="Transparent" Tapped="GroupHeader_Tapped" BackgroundSizing="InnerBorderEdge">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="10" Margin="0,0,8,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SidebarItemTemplate" x:DataType="local:ConnectionItemViewModel">
            <Grid Padding="4,8" ColumnSpacing="10" Margin="12,0,0,0">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="连接" Click="ConnectMenu_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE768;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="编辑" Click="EditMenu_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE70F;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="删除" Click="DeleteMenu_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE8C8;" FontSize="18"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind DisplayHostPort, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <!-- Monitoring stats row -->
                    <TextBlock Text="{x:Bind StatsText, Mode=OneWay}"
                               Visibility="{x:Bind IsMonitoringVisible, Mode=OneWay}"
                               FontSize="10"
                               Opacity="0.65"
                               FontFamily="Consolas"
                               Margin="0,1,0,0"/>
                </StackPanel>
                <!-- IP 遮罩切换按钮 -->
                <Button Grid.Column="2"
                        Width="28" Height="28" Padding="0"
                        Background="Transparent" BorderBrush="Transparent"
                        CornerRadius="4"
                        ToolTipService.ToolTip="显示/隐藏 IP 地址"
                        Click="ToggleIpVisibility_Click">
                    <FontIcon Glyph="{x:Bind EyeGlyph, Mode=OneWay}" FontSize="13"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Button>
            </Grid>
        </DataTemplate>

        <local:SidebarTemplateSelector x:Key="SidebarTemplateSelector"
            GroupTemplate="{StaticResource SidebarGroupTemplate}"
            ItemTemplate="{StaticResource SidebarItemTemplate}" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Connection list sidebar -->
            <ColumnDefinition Width="280" MinWidth="150" MaxWidth="600" />
            <ColumnDefinition Width="Auto" />
            <!-- Terminal tab area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Left: Connection List ──────────────────────────────────── -->
        <Grid Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Quick connect bar -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Padding="16,12,16,8">
                <TextBlock Text="SSH 连接" Style="{ThemeResource SubtitleTextBlockStyle}"/>
            </Grid>

            <!-- Quick connect bar -->
            <Grid Grid.Row="1" Padding="8,0,8,8" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="QuickConnectBox"
                         PlaceholderText="快速连接 user@host:port"
                         FontSize="12"
                         KeyDown="QuickConnectBox_KeyDown"/>
                <Button Grid.Column="1"
                        Width="32" Height="32" Padding="0"
                        ToolTipService.ToolTip="连接"
                        Click="QuickConnectButton_Click">
                    <FontIcon Glyph="&#xE768;" FontSize="13"/>
                </Button>
            </Grid>

            <!-- Connection list -->
            <ListView
                x:Name="ConnectionListView"
                Grid.Row="2"
                SelectionMode="Single"
                DoubleTapped="ConnectionListView_DoubleTapped"
                ItemsSource="{x:Bind FlatSidebarItems, Mode=OneWay}"
                ItemTemplateSelector="{StaticResource SidebarTemplateSelector}">
                <!-- Disable default add/remove stuttering animation -->
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <!-- Remove default item padding to let our margin trick work for indent -->
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="32"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Bottom toolbar -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Padding="8" Spacing="4">
                <Button x:Name="AddConnectionButton" Click="AddConnectionButton_Click"
                        ToolTipService.ToolTip="新建连接" Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="新建连接"/>
                    </StackPanel>
                </Button>
                <Button x:Name="EditConnectionButton" Click="EditConnectionButton_Click"
                        ToolTipService.ToolTip="编辑所选连接">
                    <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                </Button>
                <Button x:Name="DeleteConnectionButton" Click="DeleteConnectionButton_Click"
                        ToolTipService.ToolTip="删除所选连接">
                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <ui:GridSplitter Grid.Column="1" Width="8" Background="Transparent" />

        <!-- ── Right: Terminal TabView & Sidebar ────────────────────────────── -->
        <Grid Grid.Column="2">
            <SplitView x:Name="TerminalSplitView" DisplayMode="Inline" PanePlacement="Right" OpenPaneLength="260" IsPaneOpen="False" PaneBackground="Transparent">
                <SplitView.Content>
                    <Grid>
                        <TabView
                            x:Name="TerminalTabView"
                            AddTabButtonClick="TerminalTabView_AddTabButtonClick"
                            TabCloseRequested="TerminalTabView_TabCloseRequested"
                            SizeChanged="TerminalTabView_SizeChanged"
                            VerticalAlignment="Stretch">
                            <TabView.TabStripFooter>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2" Margin="0,0,4,0">
                                </StackPanel>
                            </TabView.TabStripFooter>
                        </TabView>

                        <!-- Empty state when no tabs -->
                        <StackPanel
                            x:Name="EmptyStatePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="16">
                            <FontIcon Glyph="&#xE8C8;" FontSize="64"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="双击左侧连接以打开终端"
                                       Style="{ThemeResource SubtitleTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="或点击「新建连接」添加一个 SSH 连接"
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </SplitView.Content>

                <SplitView.Pane>
                    <Grid x:Name="SidebarPaneGrid" Margin="0,28,0,0" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Top Tab Bar -->
                        <Grid Grid.Row="0" Margin="16,16,16,8" Height="36" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Tab 0: SFTP (Placeholder) -->
                            <ToggleButton x:Name="TabSftpButton" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0" Background="Transparent" CornerRadius="6" Click="SidebarTabButton_Click" Tag="0">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                            </ToggleButton>

                            <!-- Tab 1: Snippets -->
                            <ToggleButton x:Name="TabSnippetsButton" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0" Background="Transparent" CornerRadius="6" Click="SidebarTabButton_Click" Tag="1">
                                <FontIcon Glyph="&#xE943;" FontSize="14"/>
                            </ToggleButton>

                            <!-- Tab 2: History (Placeholder) -->
                            <ToggleButton x:Name="TabHistoryButton" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0" Background="Transparent" CornerRadius="6" Click="SidebarTabButton_Click" Tag="2">
                                <FontIcon Glyph="&#xE823;" FontSize="14"/>
                            </ToggleButton>

                            <!-- Tab 3: Themes -->
                            <ToggleButton x:Name="TabThemesButton" Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0" Background="Transparent" CornerRadius="6" Click="SidebarTabButton_Click" Tag="3">
                                <FontIcon Glyph="&#xE790;" FontSize="14"/>
                            </ToggleButton>
                        </Grid>

                        <!-- Views Container -->
                        <Grid Grid.Row="1">
                            <!-- View 0: SFTP -->
                            <Grid x:Name="SidebarSftpView" Visibility="Collapsed">
                                <TextBlock Text="SFTP 模块开发中..." HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                            </Grid>

                            <!-- View 1: Snippets -->
                            <Grid x:Name="SidebarSnippetsView" Visibility="Collapsed" Margin="16,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Content="+ 新建代码片段" Click="NewSnippetButton_Click" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" Margin="0,0,0,16"/>
                                <ListView Grid.Row="1" ItemsSource="{x:Bind Snippets, Mode=OneWay}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:SnippetViewModel">
                                            <Grid Margin="0,8" ColumnSpacing="8">
                                                <Grid.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="编辑" Click="EditSnippet_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE70F;"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="删除" Click="DeleteSnippet_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Grid.ContextFlyout>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                                    <TextBlock Text="{x:Bind Command}" FontFamily="Consolas" Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" VerticalAlignment="Center" Width="36" Height="36" Padding="0"
                                                        ToolTipService.ToolTip="运行代码片段" Click="RunSnippet_Click">
                                                    <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>

                            <!-- View 2: History -->
                            <Grid x:Name="SidebarHistoryView" Visibility="Collapsed">
                                <TextBlock Text="历史记录模块开发中..." HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                            </Grid>

                            <!-- View 3: Themes -->
                            <Grid x:Name="SidebarThemesView" Visibility="Collapsed">
                                <ListView ItemsSource="{x:Bind Themes, Mode=OneWay}" SelectionMode="Single" SelectionChanged="SidebarThemesList_SelectionChanged" Margin="8,0">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="8"/>
                                            <Setter Property="Margin" Value="0,0,0,4"/>
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ThemeViewModel">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Mini Terminal Preview -->
                                                <Border Grid.Column="0" Width="60" Height="40" Background="{x:Bind BgBrush}" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="6,8">
                                                    <StackPanel Spacing="4">
                                                        <Rectangle Height="4" Fill="{x:Bind Accent1Brush}" RadiusX="2" RadiusY="2" HorizontalAlignment="Left" Width="40"/>
                                                        <Rectangle Height="4" Fill="{x:Bind Accent2Brush}" RadiusX="2" RadiusY="2" HorizontalAlignment="Left" Width="30"/>
                                                        <Rectangle Height="4" Fill="{x:Bind Accent3Brush}" RadiusX="2" RadiusY="2" HorizontalAlignment="Left" Width="20"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- Theme Name -->
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" Style="{ThemeResource BodyTextBlockStyle}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Grid>
                    </Grid>
                </SplitView.Pane>
            </SplitView>
        </Grid>
    </Grid>
</Page>
