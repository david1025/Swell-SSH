<UserControl
    x:Class="SwellSSH.Pages.OnboardingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">
    
    <UserControl.Resources>
        <!-- 环境光动画：让背景的两个彩色球体产生缓慢的位置偏移和呼吸感 -->
        <Storyboard x:Name="AmbientLightStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Blob1Transform" Storyboard.TargetProperty="X" To="-50" Duration="0:0:8" />
            <DoubleAnimation Storyboard.TargetName="Blob1Transform" Storyboard.TargetProperty="Y" To="-30" Duration="0:0:8" />
            <DoubleAnimation Storyboard.TargetName="Blob2Transform" Storyboard.TargetProperty="X" To="50" Duration="0:0:8" />
            <DoubleAnimation Storyboard.TargetName="Blob2Transform" Storyboard.TargetProperty="Y" To="30" Duration="0:0:8" />
        </Storyboard>
    </UserControl.Resources>
    
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- 1. 背景动态环境模糊发光效果 -->
        <Grid Opacity="0.15" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- 紫色光源 -->
            <Ellipse Width="400" Height="400" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-100,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#FF8A2BE2" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="Blob1Transform" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <!-- 蓝色/靛蓝色光源 -->
            <Ellipse Width="450" Height="450" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-120,-120">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#FF007ACC" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="Blob2Transform" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>
        
        <!-- 2. 主引导卡片（透明悬浮） -->
        <Border Width="560"
                MinHeight="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="36">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- 顶部进度指示器 (Progress Dots) -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,24">
                    <Ellipse x:Name="Dot0" Width="24" Height="6" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <Ellipse x:Name="Dot1" Width="8" Height="6" Fill="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"/>
                    <Ellipse x:Name="Dot2" Width="8" Height="6" Fill="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"/>
                </StackPanel>
                
                <!-- 中间内容区 (多页容器) -->
                <Grid Grid.Row="1">
                    <!-- 第一页：欢迎页面 -->
                    <StackPanel x:Name="Page0" Visibility="Visible" Spacing="16" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/tray-icon.ico" Width="80" Height="80" HorizontalAlignment="Center" Stretch="UniformToFill" />
                        
                        <TextBlock Text="欢迎开启 Swell SSH" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Center" />
                        
                        <TextBlock Text="基于 WinUI 3 打造的现代化 Windows 原生 SSH 客户端。&#x0a;使用 Win2D 硬件加速渲染，为您提供丝滑的终端体验。" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextAlignment="Center" 
                                   HorizontalAlignment="Center" 
                                   LineHeight="22" />
                    </StackPanel>
                    
                    <!-- 第二页：个性化设置 -->
                    <StackPanel x:Name="Page1" Visibility="Collapsed" Spacing="16" VerticalAlignment="Center">
                        <TextBlock Text="个性化您的界面体验" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="一切都随您心意，自由定制您的专属开发环境。" 
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        
                        <!-- Theme Card -->
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="16">
                            <Grid ColumnDefinitions="Auto,*">
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="全局色彩主题" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <controls:Segmented Grid.Column="1" x:Name="ThemeSegmented" SelectionChanged="ThemeSegmented_SelectionChanged" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <controls:SegmentedItem Tag="Light" Padding="14,6">
                                        <controls:SegmentedItem.Content>
                                            <TextBlock Text="浅色" Width="64" TextAlignment="Center" />
                                        </controls:SegmentedItem.Content>
                                        <controls:SegmentedItem.Icon>
                                            <FontIcon Glyph="&#xE706;" FontSize="16" />
                                        </controls:SegmentedItem.Icon>
                                    </controls:SegmentedItem>
                                    <controls:SegmentedItem Tag="Dark" Padding="14,6">
                                        <controls:SegmentedItem.Content>
                                            <TextBlock Text="深色" Width="64" TextAlignment="Center" />
                                        </controls:SegmentedItem.Content>
                                        <controls:SegmentedItem.Icon>
                                            <FontIcon Glyph="&#xE708;" FontSize="16" />
                                        </controls:SegmentedItem.Icon>
                                    </controls:SegmentedItem>
                                    <controls:SegmentedItem Tag="Default" Padding="14,6">
                                        <controls:SegmentedItem.Content>
                                            <TextBlock Text="跟随系统" Width="64" TextAlignment="Center" />
                                        </controls:SegmentedItem.Content>
                                        <controls:SegmentedItem.Icon>
                                            <FontIcon Glyph="&#xE770;" FontSize="16" />
                                        </controls:SegmentedItem.Icon>
                                    </controls:SegmentedItem>
                                </controls:Segmented>
                            </Grid>
                        </Border>
                        
                        <!-- Backdrop Card -->
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="16">
                            <Grid ColumnDefinitions="Auto,*">
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="窗口背景材质" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <controls:Segmented Grid.Column="1" x:Name="BackdropSegmented" VerticalAlignment="Center" HorizontalAlignment="Right" SelectionChanged="BackdropSegmented_SelectionChanged">
                                    <controls:Segmented.Resources>
                                        <SolidColorBrush x:Key="SegmentedItemBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="SegmentedItemBorderBrushPointerOver" Color="Transparent" />
                                    </controls:Segmented.Resources>
                                    <controls:SegmentedItem Tag="Mica" Padding="14,6">
                                        <controls:SegmentedItem.Content>
                                            <TextBlock Text="Mica" FontSize="14" Width="64" TextAlignment="Center" />
                                        </controls:SegmentedItem.Content>
                                        <controls:SegmentedItem.Icon>
                                            <FontIcon Glyph="&#xE706;" FontSize="16" />
                                        </controls:SegmentedItem.Icon>
                                    </controls:SegmentedItem>
                                    <controls:SegmentedItem Tag="Acrylic" Padding="14,6">
                                        <controls:SegmentedItem.Content>
                                            <TextBlock Text="Acrylic" FontSize="14" Width="64" TextAlignment="Center" />
                                        </controls:SegmentedItem.Content>
                                        <controls:SegmentedItem.Icon>
                                            <FontIcon Glyph="&#xE708;" FontSize="16" />
                                        </controls:SegmentedItem.Icon>
                                    </controls:SegmentedItem>
                                    <controls:SegmentedItem Tag="None" Padding="14,6">
                                        <controls:SegmentedItem.Content>
                                            <TextBlock Text="None" FontSize="14" Width="64" TextAlignment="Center" />
                                        </controls:SegmentedItem.Content>
                                        <controls:SegmentedItem.Icon>
                                            <FontIcon Glyph="&#xE770;" FontSize="16" />
                                        </controls:SegmentedItem.Icon>
                                    </controls:SegmentedItem>
                                </controls:Segmented>
                            </Grid>
                        </Border>
                        
                        <!-- Cursor Card -->
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="16">
                            <Grid ColumnDefinitions="Auto,*">
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="终端光标样式" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="32" VerticalAlignment="Center">
                                    <RadioButton x:Name="CursorBlock" Content="块状" GroupName="CursorStyle" IsChecked="True" Checked="CursorStyle_Checked" Tag="Block" Margin="0" MinWidth="0"/>
                                    <RadioButton x:Name="CursorUnderline" Content="下划线" GroupName="CursorStyle" Checked="CursorStyle_Checked" Tag="Underline" Margin="0" MinWidth="0"/>
                                    <RadioButton x:Name="CursorBar" Content="竖线" GroupName="CursorStyle" Checked="CursorStyle_Checked" Tag="Bar" Margin="0" MinWidth="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                    
                    <!-- 第三页：准备就绪 -->
                    <StackPanel x:Name="Page2" Visibility="Collapsed" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="一切准备就绪！" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="点击立即开启，配置属于你的第一台服务器。" 
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                   HorizontalAlignment="Center" Margin="0,0,0,24"/>
                    </StackPanel>
                </Grid>
                
                <!-- 底部导航按钮 -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,24,0,0">
                    <Button Grid.Column="0" 
                            x:Name="PrevButton" 
                            Content="上一步" 
                            Click="PrevButton_Click" 
                            Visibility="Collapsed" 
                            Style="{StaticResource DefaultButtonStyle}"/>
                    
                    <Button Grid.Column="2" 
                            x:Name="NextButton" 
                            Content="下一步" 
                            Click="NextButton_Click" 
                            Style="{StaticResource AccentButtonStyle}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
