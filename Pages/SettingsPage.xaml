<Page
    x:Class="SwellSSH.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SwellSSH.Pages"
    NavigationCacheMode="Required">

    <ScrollViewer Padding="32,24">
        <StackPanel MaxWidth="600" Spacing="24">
            <TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}"/>

            <!-- Search Box -->
            <AutoSuggestBox x:Name="SettingsSearchBox"
                            PlaceholderText="搜索设置项…"
                            QueryIcon="Find"
                            HorizontalAlignment="Stretch"
                            TextChanged="SettingsSearchBox_TextChanged"/>

            <!-- No Results Hint -->
            <TextBlock x:Name="NoResultsText"
                       Text="没有匹配的设置项"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,16"
                       Visibility="Collapsed"/>

            <!-- Font -->
            <StackPanel x:Name="FontSection" Spacing="8">
                <TextBlock Text="终端字体" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <ComboBox x:Name="FontFamilyCombo" Header="字体" Width="300" HorizontalAlignment="Left"
                          SelectionChanged="FontFamilyCombo_SelectionChanged"/>
                <Slider x:Name="FontSizeSlider" Header="字体大小" Minimum="10" Maximum="32" StepFrequency="1"
                        Width="300" HorizontalAlignment="Left" ValueChanged="FontSizeSlider_ValueChanged"/>
            </StackPanel>

            <!-- Color scheme -->
            <StackPanel x:Name="ColorSchemeSection" Spacing="8">
                <TextBlock Text="配色方案" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <ComboBox x:Name="ColorSchemeCombo" Header="主题"
                          ItemsSource="{x:Bind ColorSchemes}"
                          Width="300" HorizontalAlignment="Left"
                          SelectionChanged="ColorSchemeCombo_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="local:ColorSchemeItem">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE91F;" Foreground="{x:Bind ColorBrush}" FontSize="14"/>
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Cursor -->
            <StackPanel x:Name="CursorSection" Spacing="8">
                <TextBlock Text="光标样式" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <RadioButton x:Name="CursorBlock" Content="块状" GroupName="CursorStyle" IsChecked="True"
                                 Checked="CursorStyle_Checked" Tag="Block"/>
                    <RadioButton x:Name="CursorUnderline" Content="下划线" GroupName="CursorStyle"
                                 Checked="CursorStyle_Checked" Tag="Underline"/>
                    <RadioButton x:Name="CursorBar" Content="竖线" GroupName="CursorStyle"
                                 Checked="CursorStyle_Checked" Tag="Bar"/>
                </StackPanel>
                <ToggleSwitch x:Name="CursorBlinkToggle" Header="光标闪烁" IsOn="True"
                              Toggled="CursorBlinkToggle_Toggled"/>
            </StackPanel>

            <!-- Backdrop -->
            <StackPanel x:Name="BackdropSection" Spacing="8">
                <TextBlock Text="窗口背景" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <ComboBox x:Name="BackdropCombo" Header="背景材质"
                          ItemsSource="{x:Bind BackdropTypes}"
                          Width="300" HorizontalAlignment="Left"
                          SelectionChanged="BackdropCombo_SelectionChanged"/>
            </StackPanel>

            <!-- Behavior -->
            <StackPanel x:Name="BehaviorSection" Spacing="8">
                <TextBlock Text="行为" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <ToggleSwitch x:Name="MinimizeOnCloseToggle" Header="关闭时最小化到托盘" IsOn="True"
                              Toggled="MinimizeOnCloseToggle_Toggled"/>
            </StackPanel>

            <MenuFlyoutSeparator x:Name="AboutSeparator" Margin="0,12"/>

            <!-- About -->
            <StackPanel x:Name="AboutSection" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="关于 SwellSSH" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                    <HyperlinkButton NavigateUri="https://github.com/yaog6700-bit/Swell-SSH" ToolTipService.ToolTip="访问项目 GitHub 主页" Padding="6" CornerRadius="4" MinWidth="0" MinHeight="0" VerticalAlignment="Center">
                        <Viewbox Width="18" Height="18">
                            <PathIcon Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
                        </Viewbox>
                    </HyperlinkButton>
                </StackPanel>
                <TextBlock x:Name="AppVersionText"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="现代化的 Windows SSH 客户端，使用 Win2D 硬件加速渲染与原生 WinUI 3 打造。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <Button x:Name="CheckAppUpdateButton"
                        Content="检查更新"
                        Margin="0,8,0,0"
                        Click="CheckAppUpdateButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
