<Page
    x:Class="SwellSSH.Pages.SftpPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SwellSSH.Pages"
    xmlns:ui="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <Page.Resources>
        <ResourceDictionary>
            <!--
                Theme-aware brush overrides for the sort-header buttons built in C#.
                GetThemeBrush() looks up Page.Resources.ThemeDictionaries first,
                guaranteeing correct values regardless of app-level theme context
                (fixes dark-mode text being black when hosted inside a TabView).
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5C5C5"/>
                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#1FFFFFFF"/>
                    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0FFFFFFF"/>
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#15FFFFFF"/>
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#2B2B2B"/>
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#1FFFFFFF"/>
                    <Color x:Key="SearchBoxBackgroundColor">#2A2A2A</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1A1A1A"/>
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#707070"/>
                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0A000000"/>
                    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#14000000"/>
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#14000000"/>
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#F0F0F0"/>
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#0F000000"/>
                    <Color x:Key="SearchBoxBackgroundColor">#F3F3F3</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        <DataTemplate x:Key="FileItemTemplate" x:DataType="local:SftpFileItemViewModel">
            <Grid Padding="8,7" ColumnSpacing="10" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0"
                          Glyph="{x:Bind IconGlyph}"
                          FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="1"
                           Text="{x:Bind Name}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{x:Bind KindText}"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3"
                           Text="{x:Bind SizeText}"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4"
                           Text="{x:Bind ModifiedText}"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <Style x:Key="FileHeaderGridStyle" TargetType="Grid">
            <Setter Property="Height" Value="34"/>
            <Setter Property="ColumnSpacing" Value="10"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="6,6,0,0"/>
        </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="16,8,16,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" MinHeight="40" Padding="0,0,0,4">
                    <TextBlock Text="本机"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center"/>
                </Border>

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="本机文件"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center"/>
                    <Grid Grid.Column="2" x:Name="LocalSearchContainer" Width="34" ColumnSpacing="0">
                        <TextBox x:Name="LocalSearchBox"
                                 PlaceholderText="搜索文件..."
                                 FontSize="13"
                                 Visibility="Collapsed"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="4,5,4,5"
                                 TextChanged="LocalSearchBox_TextChanged"
                                 KeyDown="LocalSearchBox_KeyDown2"
                                 LostFocus="LocalSearchBox_LostFocus">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource SearchBoxBackgroundColor}"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource SearchBoxBackgroundColor}"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource SearchBoxBackgroundColor}"/>
                                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{ThemeResource SearchBoxBackgroundColor}"/>
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                            </TextBox.Resources>
                        </TextBox>
                        <Button x:Name="LocalSearchIconBtn"
                                Width="34" Height="34" Padding="0"
                                ToolTipService.ToolTip="搜索"
                                Click="LocalSearchIcon_Click">
                            <FontIcon Glyph="&#xE721;" FontSize="14"/>
                        </Button>
                    </Grid>
                    <ToggleButton Grid.Column="3"
                                  x:Name="LocalHiddenFilesToggle"
                                  Width="34"
                                  Height="34"
                                  Padding="0"
                                  IsChecked="False"
                                  ToolTipService.ToolTip="显示隐藏文件"
                                  Click="LocalHiddenFilesToggle_Click">
                        <FontIcon Glyph="&#xED1A;" FontSize="14"/>
                    </ToggleButton>
                    <Button Grid.Column="4"
                            Width="34"
                            Height="34"
                            Padding="0"
                            ToolTipService.ToolTip="返回上级"
                            Click="LocalUpButton_Click">
                        <FontIcon Glyph="&#xE74A;" FontSize="14"/>
                    </Button>
                    <Button Grid.Column="5"
                            Width="34"
                            Height="34"
                            Padding="0"
                            ToolTipService.ToolTip="刷新"
                            Click="LocalRefreshButton_Click">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    </Button>
                </Grid>

                <TextBox Grid.Row="2"
                         x:Name="LocalPathBox"
                         Text="{x:Bind LocalPath, Mode=OneWay}"
                         FontFamily="Consolas"
                         KeyDown="LocalPathBox_KeyDown"/>

                <Grid x:Name="LocalHeaderGrid"
                      Grid.Row="3"
                      Style="{StaticResource FileHeaderGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="LocalKindHeaderColumn" Width="84"/>
                        <ColumnDefinition x:Name="LocalSizeHeaderColumn" Width="92"/>
                        <ColumnDefinition x:Name="LocalModifiedHeaderColumn" Width="140"/>
                    </Grid.ColumnDefinitions>
                </Grid>

                <ListView Grid.Row="4"
                          x:Name="LocalFileList"
                          ItemsSource="{x:Bind LocalItems, Mode=OneWay}"
                          ItemTemplate="{StaticResource FileItemTemplate}"
                          SelectionMode="Extended"
                          IsDoubleTapEnabled="True"
                          DoubleTapped="LocalFileList_DoubleTapped"
                          RightTapped="LocalFileList_RightTapped"
                          CanDragItems="True"
                          DragItemsStarting="LocalFileList_DragItemsStarting"
                          AllowDrop="True"
                          DragOver="LocalFileList_DragOver"
                          Drop="LocalFileList_Drop">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,2"/>
                            <Setter Property="CornerRadius" Value="6"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>

            <ui:GridSplitter Grid.Column="1"
                             ResizeDirection="Columns"
                             Background="{ThemeResource CardStrokeColorDefaultBrush}"
                             HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2">
                <TabView x:Name="RemoteTabView"
                         AddTabButtonClick="RemoteTabView_AddTabButtonClick"
                         TabCloseRequested="RemoteTabView_TabCloseRequested"
                         TabWidthMode="Equal">
                    <TabView.Resources>
                        <x:Double x:Key="TabViewItemHeaderHeight">36</x:Double>
                    </TabView.Resources>
                    <TabView.TabStripHeader>
                        <TextBlock Text="远程服务器"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"/>
                    </TabView.TabStripHeader>
                </TabView>

                <Grid x:Name="RemoteEmptyState"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      MaxWidth="420"
                      Padding="24">
                    <StackPanel Spacing="14">
                        <FontIcon Glyph="&#xE8B7;"
                                  FontSize="44"
                                  HorizontalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="打开一个远程 SFTP 会话"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center"/>
                        <Button HorizontalAlignment="Center"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="OpenRemoteButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                <TextBlock Text="选择连接"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Border x:Name="TransferPanel"
                Grid.Row="1"
                Visibility="Collapsed"
                Padding="12,9"
                CornerRadius="6"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0"
                          Glyph="&#xE895;"
                          FontSize="15"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                          VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind TransferProgress.Title, Mode=OneWay}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind TransferProgress.Detail, Mode=OneWay}"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="{x:Bind TransferProgress.SpeedText, Mode=OneWay}"
                           FontFamily="Consolas"
                           FontSize="12"
                           MinWidth="72"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Right"
                           VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="3"
                             Minimum="0"
                             Maximum="100"
                             Value="{x:Bind TransferProgress.Percent, Mode=OneWay}"
                             VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4"
                           Text="{x:Bind TransferProgress.PercentText, Mode=OneWay}"
                           FontFamily="Consolas"
                           FontSize="12"
                           MinWidth="44"
                           TextAlignment="Right"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="5"
                        Click="DismissTransferButton_Click"
                        Padding="4"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="关闭">
                    <FontIcon Glyph="&#xE8BB;" FontSize="12"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
