<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>SwellSSH.Updater</RootNamespace>
    <AssemblyName>SwellSSH.Updater</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Title>SwellSSH Updater</Title>
    <Product>SwellSSH</Product>
    <!-- Native AOT: 极小体积，无需 .NET 运行时依赖 -->
    <!-- 只在 CI publish 时激活（命令行传入 -p:PublishAot=true），本地 build/run 不受影响 -->
    <StripSymbols Condition="'$(PublishAot)' == 'true'">true</StripSymbols>
    <OptimizeSpeed>false</OptimizeSpeed>
  </PropertyGroup>

  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
  </PropertyGroup>
</Project>
